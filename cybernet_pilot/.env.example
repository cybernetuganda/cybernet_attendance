# Copy this file to .env on the computer connected to the K40. Never commit .env.
# Required for live operation. Demo scans require APP_MODE=demo explicitly.
APP_MODE=device
SCHOOL_NAME=
# Set a long random value so signed login sessions survive app restarts.
APP_SECRET=
# Set true only when the browser reaches the app over HTTPS.
SESSION_COOKIE_SECURE=false
# Required: the K40's real IPv4 address on this computer's local network.
DEVICE_IP=
# Confirm these values against the terminal's communication settings.
DEVICE_PORT=4370
DEVICE_COMM_KEY=0
DEVICE_FORCE_UDP=false
# PUNCH uses terminal codes 0=IN, 1=OUT; validate on your K40 first.
# Use IN or OUT for a terminal dedicated to one direction.
DEVICE_DIRECTION=PUNCH
POLL_SECONDS=10

# Pandora is the default SMS provider. These three values are required before
# staff can manually enable paid automatic SMS in Settings after a baseline poll.
# Use the sender approved for this Pandora account (maximum 11 characters).
SMS_PROVIDER=pandora
PANDORA_USERNAME=
PANDORA_PASSWORD=
PANDORA_SENDER=
PANDORA_MESSAGE_TYPE=non_customised
# Change these only if Pandora confirms different settings for this account.
PANDORA_SENDER_FIELD=sender
PANDORA_API_URL=https://www.sms.thepandoranetworks.com/API/send_sms/

# Optional Africa's Talking alternative: set SMS_PROVIDER=africastalking.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
