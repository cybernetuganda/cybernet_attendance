APP_MODE=device
# Set the real institution name and K40 LAN address before starting live polling.
SCHOOL_NAME=
DASHBOARD_PASSWORD=
APP_SECRET=
DEVICE_IP=
DEVICE_PORT=4370
DEVICE_COMM_KEY=0
DEVICE_FORCE_UDP=false
# PUNCH uses terminal codes 0=IN, 1=OUT; validate on your K40 first.
# Use IN or OUT for a terminal dedicated to one direction.
DEVICE_DIRECTION=PUNCH
POLL_SECONDS=10
# Optional Africa's Talking alternative; set SMS_PROVIDER=africastalking to use it.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Pandora integration (default provider). Keep actual credentials private.
SMS_PROVIDER=pandora
PANDORA_USERNAME=
PANDORA_PASSWORD=
PANDORA_SENDER=
PANDORA_MESSAGE_TYPE=non_customised
# Documentation lists sender; its POST sample uses sender_id.
PANDORA_SENDER_FIELD=sender
